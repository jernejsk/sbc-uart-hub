# /etc/udev/rules.d/70-sbc-uart-hub.rules: stable /dev/sbcu/chNN names
SUBSYSTEM=="tty", SUBSYSTEMS=="usb", ATTRS{serial}=="SBCU-1", ATTRS{bInterfaceNumber}=="00", SYMLINK+="sbcu/ch01"
SUBSYSTEM=="tty", SUBSYSTEMS=="usb", ATTRS{serial}=="SBCU-1", ATTRS{bInterfaceNumber}=="01", SYMLINK+="sbcu/ch02"
SUBSYSTEM=="tty", SUBSYSTEMS=="usb", ATTRS{serial}=="SBCU-1", ATTRS{bInterfaceNumber}=="02", SYMLINK+="sbcu/ch03"
SUBSYSTEM=="tty", SUBSYSTEMS=="usb", ATTRS{serial}=="SBCU-1", ATTRS{bInterfaceNumber}=="03", SYMLINK+="sbcu/ch04"
SUBSYSTEM=="tty", SUBSYSTEMS=="usb", ATTRS{serial}=="SBCU-2", ATTRS{bInterfaceNumber}=="00", SYMLINK+="sbcu/ch05"
SUBSYSTEM=="tty", SUBSYSTEMS=="usb", ATTRS{serial}=="SBCU-2", ATTRS{bInterfaceNumber}=="01", SYMLINK+="sbcu/ch06"
SUBSYSTEM=="tty", SUBSYSTEMS=="usb", ATTRS{serial}=="SBCU-2", ATTRS{bInterfaceNumber}=="02", SYMLINK+="sbcu/ch07"
SUBSYSTEM=="tty", SUBSYSTEMS=="usb", ATTRS{serial}=="SBCU-2", ATTRS{bInterfaceNumber}=="03", SYMLINK+="sbcu/ch08"
SUBSYSTEM=="tty", SUBSYSTEMS=="usb", ATTRS{serial}=="SBCU-3", ATTRS{bInterfaceNumber}=="00", SYMLINK+="sbcu/ch09"
SUBSYSTEM=="tty", SUBSYSTEMS=="usb", ATTRS{serial}=="SBCU-3", ATTRS{bInterfaceNumber}=="01", SYMLINK+="sbcu/ch10"
SUBSYSTEM=="tty", SUBSYSTEMS=="usb", ATTRS{serial}=="SBCU-3", ATTRS{bInterfaceNumber}=="02", SYMLINK+="sbcu/ch11"
SUBSYSTEM=="tty", SUBSYSTEMS=="usb", ATTRS{serial}=="SBCU-3", ATTRS{bInterfaceNumber}=="03", SYMLINK+="sbcu/ch12"
SUBSYSTEM=="tty", SUBSYSTEMS=="usb", ATTRS{serial}=="SBCU-4", ATTRS{bInterfaceNumber}=="00", SYMLINK+="sbcu/ch13"
SUBSYSTEM=="tty", SUBSYSTEMS=="usb", ATTRS{serial}=="SBCU-4", ATTRS{bInterfaceNumber}=="01", SYMLINK+="sbcu/ch14"
SUBSYSTEM=="tty", SUBSYSTEMS=="usb", ATTRS{serial}=="SBCU-4", ATTRS{bInterfaceNumber}=="02", SYMLINK+="sbcu/ch15"
SUBSYSTEM=="tty", SUBSYSTEMS=="usb", ATTRS{serial}=="SBCU-4", ATTRS{bInterfaceNumber}=="03", SYMLINK+="sbcu/ch16"
